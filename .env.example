# Pull the real local env from Vercel instead of committing secrets:
#   npm run env:pull:prod

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
CONTACT_FORM_EMAIL=contact@example.com
VITE_CONTACT_EMAIL=contact@example.com
MAIL_PROVIDER=resend
# Use a sender on a domain or subdomain verified in Resend, e.g. contact@mail.example.com
MAIL_FROM_EMAIL=contact@mail.example.com
MAIL_FROM_NAME=Taxi Le Havre
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_PLACE_ID=your-google-place-id
GOOGLE_PLACE_TEXT_QUERY=Taxi Le Havre, Le Havre, France
GOOGLE_REVIEWS_MIN_RATING=4

# GTM is installed globally in index.html with this public container ID.
VITE_GTM_ID=GTM-KVP785FQ
VITE_GA_MEASUREMENT_ID=G-LMVZ2BD576
