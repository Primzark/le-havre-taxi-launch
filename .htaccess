RewriteEngine On

# Block access to hidden files/directories (.git, .env, etc.)
RedirectMatch 404 /\.

# Force favicon requests to the generated taxi logo files.
RewriteRule ^favicon\.ico$ favicon.ico [L]
RewriteRule ^favicon\.png$ favicon.png [L]

# Permanent redirect from legacy/non-www domains to primary www domain.
RewriteCond %{HTTP_HOST} ^(taxihavre\.com|www\.taxihavre\.com|taxis-lehavre\.com)$ [NC]
RewriteRule ^ https://www.taxis-lehavre.com%{REQUEST_URI} [R=301,L,NE]

# Avoid browser/favicon DB stale cache for icon assets.
<IfModule mod_headers.c>
  <FilesMatch "^favicon\.(ico|png)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Keep old contact slugs landing on homepage.
RewriteRule ^nous-contact/?$ / [R=301,L]
RewriteRule ^nous-contacter/?$ / [R=301,L]

# SPA fallback for React Router.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
