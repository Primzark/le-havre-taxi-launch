{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/nous-contact",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nous-contact/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nous-contacter",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nous-contacter/",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/uploads/:path*",
      "destination": "/api/uploads.php?path=:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
