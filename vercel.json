{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "taxihavre.com"
        }
      ],
      "destination": "https://le-havre-taxi-launch.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.taxihavre.com"
        }
      ],
      "destination": "https://le-havre-taxi-launch.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "taxis-lehavre.com"
        }
      ],
      "destination": "https://le-havre-taxi-launch.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.taxis-lehavre.com"
        }
      ],
      "destination": "https://le-havre-taxi-launch.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/nous-contact",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nous-contact/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nous-contacter",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nous-contacter/",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/uploads/:path*",
      "destination": "/api/uploads.php?path=:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
